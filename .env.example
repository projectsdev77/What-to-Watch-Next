# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the client. Used for trusted backend writes,
# and for actually deleting a user's auth account (see deleteAccountAction).
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app, used to build the redirect link in password reset
# emails (must also be added under Supabase Dashboard -> Authentication ->
# URL Configuration -> Redirect URLs). Defaults to localhost if unset.
# Server-only — only read inside Server Actions, never sent to the
# browser, so it deliberately has no NEXT_PUBLIC_ prefix.
SITE_URL=http://localhost:3000

# TMDB (themoviedb.org -> Settings -> API)
# Used for catalog metadata AND availability (/watch/providers, JustWatch-sourced).
# Free tier. See README "Data sources" for the tradeoffs and the recommended
# upgrade path (Watchmode) if this ships as a real commercial product.
TMDB_API_KEY=

# Protects /api/cron/refresh-catalog (the scheduled catalog-broadening
# sync — see README "Keeping the catalog fresh"). Any random long string;
# generate one with `openssl rand -hex 32`. Required — the route refuses
# to run without it. If deployed on Vercel, also set this same value as
# a project environment variable so Vercel Cron sends it automatically.
CRON_SECRET=

# OMDb (omdbapi.com/apikey.aspx -> FREE tier). Optional: powers the real
# IMDb + Rotten Tomatoes ratings shown on a title's detail page. If unset,
# titles just show without them rather than breaking ingestion. New key
# emails require clicking an activation link before they work.
OMDB_API_KEY=

# Google Gemini (aistudio.google.com/apikey -> free tier). Optional:
# lets an external AI choose Tonight's Pick from an already-scored
# shortlist of real, available titles and write the "why" line, instead
# of the plain top-score pick. If unset (or the call fails), Tonight's
# Pick falls back to the deterministic scoring pick — same as before
# this existed. See src/lib/gemini.ts.
GEMINI_API_KEY=
